<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 控制器 UI 需要枚举已安装应用 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- 开机后主动把规则推给 SystemUI（SystemUI 重启/手机重启都能自动恢复） -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 游戏模式的"寄生通知"（API 33+ 需要运行时授权；没有授权时磁贴与锁屏退出仍可用） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- ================= LSPosed 模块声明 ================= -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="@string/xposed_description" />
        <meta-data
            android:name="xposedminversion"
            android:value="82" />
        <!-- 预填作用域：只需要 System UI -->
        <meta-data
            android:name="xposedscope"
            android:resource="@array/xposed_scope" />

        <!-- ================= 控制器 UI ================= -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ================= 规则读取（Hook 进程兜底拉取） ================= -->
        <provider
            android:name=".common.RulesProvider"
            android:authorities="com.edgeguard.gesture.rules"
            android:enabled="true"
            android:exported="true"
            android:grantUriPermissions="false" />

        <!-- ================= 规则主动推送 / 状态回收 ================= -->
        <receiver
            android:name=".app.SyncReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="com.edgeguard.gesture.action.RULES_REQUEST" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".app.StatusReceiver"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="com.edgeguard.gesture.action.STATUS_PUSH" />
            </intent-filter>
        </receiver>

        <!-- ================= 游戏模式：常驻通知按钮 ================= -->
        <receiver
            android:name=".app.ArmedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.edgeguard.gesture.action.NOTIFY_EXIT" />
                <action android:name="com.edgeguard.gesture.action.NOTIFY_TOGGLE" />
            </intent-filter>
        </receiver>

        <!-- ================= 游戏模式：控制中心磁贴 ================= -->
        <service
            android:name=".app.GameTileService"
            android:exported="true"
            android:icon="@drawable/ic_game_mode"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>

        <!-- ================= 可选前台应用助手（无障碍推送，默认关闭） ================= -->
        <service
            android:name=".app.ForegroundAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
